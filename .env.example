# 数据库：不填则使用内置 PGlite（数据存在 .data/，重新部署会丢失）；生产环境建议使用 Postgres
DATABASE_URL=

# 用于加密探测 Key 和签名会话，生产环境务必设置一个 32 位以上的随机字符串
APP_SECRET=

# 管理员邮箱，多个用逗号分隔；这些邮箱登录后自动成为管理员
ADMIN_EMAILS=

# 登录验证码邮件，例如 smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=源流 <no-reply@example.com>

# 未配置邮件的演示环境可设为 1，在登录页直接显示验证码（正式环境不要开启）
LOGIN_DEV_CODES=

# 通知推送
TELEGRAM_BOT_TOKEN=
SITE_URL=https://yuanliu.example

# 探测调度：多实例部署时 Web 进程设为 off，另起 `pnpm worker`
SCHEDULER=
PROBE_INTERVAL_SEC=300
# 演示渠道没有真实 Key，默认模拟探测数据；设为 off 关闭
DEMO_SIMULATION=
